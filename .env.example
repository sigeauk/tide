TIDE_VERSION=latest
APP_URL=https://tide
SYNC_INTERVAL_MINUTES=60

AUTH_DISABLED=false
SSL_VERIFY=true
# Required: a random secret used to sign session cookies. TIDE will not start
# without one set (unless AUTH_DISABLED=true). Generate one offline with either:
#   openssl rand -base64 48
#   docker run --rm --entrypoint python sigeauk/tide:<your version> -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=tide
KEYCLOAK_CLIENT_ID=tide-app
KEYCLOAK_CLIENT_SECRET=

ELASTIC_APM_SERVICE_NAME=TIDE
ELASTIC_APM_SERVER_URL=http://fleet:8200
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_API_KEY=
ELASTIC_APM_ENABLED=true
ELASTIC_APM_CENTRAL_CONFIG=false
ELASTIC_APM_ENVIRONMENT=production