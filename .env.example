TIDE_VERSION=latest
APP_URL=https://tide
SYNC_INTERVAL_MINUTES=60

AUTH_DISABLED=false
SSL_VERIFY=true
# Required: a random secret used to sign session cookies. TIDE will not start
# without one set (unless AUTH_DISABLED=true). Generate one offline with either:
#   openssl rand -base64 48
#   docker run --rm --entrypoint python sigeauk/tide:<your version> -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Where backups are saved on this host (Settings -> Management -> Backups). Default: backups/
# next to docker-compose.yml. Another disk is better: a backup on the same disk as data/ won't
# survive that disk failing.
# BACKUP_PATH=/mnt/backup-disk/tide

# Keycloak single sign-on (optional). Read once: the first start with these set makes them the
# Keycloak integration (Settings -> Management -> Integrations), which is managed in TIDE from then
# on; these lines are then not read. You can also add Keycloak there instead of here.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=tide
KEYCLOAK_CLIENT_ID=tide-app
KEYCLOAK_CLIENT_SECRET=

ELASTIC_APM_SERVICE_NAME=TIDE
ELASTIC_APM_SERVER_URL=http://fleet:8200
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_API_KEY=
ELASTIC_APM_ENABLED=true
ELASTIC_APM_CENTRAL_CONFIG=false
ELASTIC_APM_ENVIRONMENT=production